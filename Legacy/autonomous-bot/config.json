      "match": "\\[A\\]\\[B\\]\\s*:",
      "reply": "A",
      "once": true
    },
    {
      "match": "(choose|select).*(game|universe).*(a|b)|game\\s*(a|b)",
      "reply": "A",
      "once": true
    },
    {
      "match": "(new user|new player|create (an )?account|register)\\s*\\(?(y/n|yes/no)\\)?",
      "reply": "y",
      "once": false
    },
    {
      "match": "(do you have an account|existing user)\\s*\\(?(y/n|yes/no)\\)?",
      "reply": "n",
      "once": false
    },
    {
      "match": "(start a new character|new character in this game).*(type y or n|y/n)",
      "reply": "y",
      "once": false
    },
    {
      "match": "use \\(n\\)ew name or \\(b\\)bs name",
      "reply": "B",
      "once": false
    },
    {
      "match": "what do you want to name your ship",
      "reply": "{username}-1",
      "once": false
    },
    {
      "match": "what do you want to name your home planet",
      "reply": "{username}-home",
      "once": false
    },
    {
      "match": "planet command.*\\[[A-Z]\\]",
      "reply": "Q",
      "once": true
    },
    {
      "match": "is what you want\\?",
      "reply": "y",
      "once": false
    },
    {
      "match": "(press\\s+enter|hit\\s+enter|continue\\.\\.\\.)",
      "reply": "",
      "allowEmpty": true,
      "once": false
    },
    {
      "match": "press\\s+space\\s+or\\s+enter\\s+to\\s+continue",
      "reply": "",
      "allowEmpty": true,
      "once": false
    },
    {
      "match": "\\[pause\\]",
      "reply": "",
      "allowEmpty": true,
      "once": false
    },
    {
      "match": "enter your choice\\s*:",
      "reply": "T",
      "once": true
    },
    {
      "match": "show today'?s log\\?\\s*\\(y/n\\)",
      "reply": "N",
      "once": true
    },
    {
      "match": "engage\\s+the\\s+autopilot\\?",
      "reply": "y",
      "once": false
    },
    {
      "match": "^computer\\s+command\\s*\\[",
