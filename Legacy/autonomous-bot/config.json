      "reply": "N",
      "once": false
    },
    {
      "match": "(yes/no|y/n)\\s*[:?]$",
      "reply": "y",
      "once": false
    },
    {
      "match": "do you want to engage.*\\(y/n\\)",
      "reply": "n",
      "once": false
