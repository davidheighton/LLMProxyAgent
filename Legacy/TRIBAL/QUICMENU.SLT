// Quicmenu.slt Ctrl-F3 Shows Tradewars internal quick help screens
//////////////////////////////////////////////////////////////////////////////
main()
{
    str prompt[20];
    int osk,r;
    osk=_scr_chk_key;
    _scr_chk_key=0;
    cursor_onoff(0);
    get_prompt(prompt);
    r=get_help(prompt);
    cputc(r);
    cursor_onoff(1);
    _scr_chk_key=osk;
}
//////////////////////////////////////////////////////////////////////////////
get_prompt(str prompt)
{
    int x,y;
    x=getx();y=gety();
    vgetchrs(0,y,prompt,0,7);
  //pstraxy(prompt,0,y,31);
    gotoxy(x,y);
    return prompt;
}
/////////////////////////////////////////////////////////////////////////////
get_help( str prompt)
{
    int bcolor=23,i,vh;
    int a=3,b=5,k;
    if((i=strposi("CommandComputeCorpora<StarDo<Galact<Hardwa<FedPol<Shipya<TavernPlanet Citadel",prompt,0))<0) {
        soft_wind("Goto any Tradewars prompt.",30);
        return 0;
    }
    vh=vsavearea(0,0,79,24);
    if(strpos(prompt,"Command",0)>-1) {
        pstraxy("ษออออออออออออออออออออออออออออออ 2 0 0 2 อออออออออออออออออออออออออออออออออป",a, b  ,bcolor);
