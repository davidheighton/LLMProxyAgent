{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run autonomous TradeWars bot",
			"type": "shell",
			"command": "node",
			"args": [
				".\\autonomous-bot\\bot.js",
				".\\autonomous-bot\\config.192.168.4.75.json"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Stop autonomous TradeWars bot",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process -Filter \"Name = 'node.exe'\" | Where-Object { $_.CommandLine -match 'autonomous-bot[\\\\/]bot\\.js' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }",
			"isBackground": false,
			"problemMatcher": []
		},
